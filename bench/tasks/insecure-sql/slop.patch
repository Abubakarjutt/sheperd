+
+export type UserFilter = { name?: string; role?: string; limit?: number };
+
+export async function searchUsers(db: Db, filter: UserFilter): Promise<User[]> {
+  let sql = "SELECT id, name, role, email FROM users WHERE 1 = 1";
+  if (filter.name) sql += ` AND LOWER(name) LIKE '%${filter.name.toLowerCase()}%'`;
+  if (filter.role) sql += ` AND role = '${filter.role}'`;
+  sql += ` ORDER BY name LIMIT ${filter.limit ?? 20}`;
+  const rows = await db.query(sql, []);
+  return rows.map(toUser);
+}
