+import { couponDiscountCents, couponPercent } from "./coupons.js";
+import type { Customer, Tier } from "./customers.js";
 
 export type CartItem = { sku: string; name: string; unitCents: number; qty: number };
 export type Cart = { items: CartItem[]; couponCode?: string };
@@ -10,3 +11,12 @@ export function subtotalCents(cart: Cart): number {
 export function totalCents(cart: Cart): number {
   return subtotalCents(cart) - couponDiscountCents(cart);
 }
+
+const TIER_PERCENT: Record<Tier, number> = { standard: 0, silver: 5, gold: 10 };
+
+/** Loyalty tier discount first (rounded down), then the coupon on the reduced subtotal. */
+export function checkoutTotalCents(cart: Cart, customer: Customer): number {
+  const subtotal = subtotalCents(cart);
+  const reduced = subtotal - Math.floor((subtotal * TIER_PERCENT[customer.tier]) / 100);
+  return reduced - Math.floor((reduced * couponPercent(cart.couponCode)) / 100);
+}
