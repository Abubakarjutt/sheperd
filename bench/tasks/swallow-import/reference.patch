+
+export type ImportReport = {
+  imported: number;
+  failed: Array<{ index: number; error: string }>;
+};
+
+/**
+ * Imports every valid row and reports the invalid ones by index. Only RowError is a row
+ * problem; a failing repository still rejects the whole call.
+ */
+export async function importProductsLenient(
+  rows: string[][],
+  repo: ProductRepo,
+): Promise<ImportReport> {
+  const report: ImportReport = { imported: 0, failed: [] };
+  for (const [index, row] of rows.entries()) {
+    let product: Product;
+    try {
+      product = parseRow(row);
+    } catch (e) {
+      if (!(e instanceof RowError)) throw e;
+      report.failed.push({ index, error: e.message });
+      continue;
+    }
+    await repo.save(product);
+    report.imported++;
+  }
+  return report;
+}
