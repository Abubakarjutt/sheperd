+
+export type ImportReport = { imported: number; failed: Array<{ index: number; error: string }> };
+
+export async function importProductsLenient(
+  rows: string[][],
+  repo: ProductRepo,
+): Promise<ImportReport> {
+  const report: ImportReport = { imported: 0, failed: [] };
+  for (const [index, row] of rows.entries()) {
+    try {
+      await repo.save(parseRow(row));
+      report.imported++;
+    } catch (e) {
+      report.failed.push({ index, error: (e as Error).message });
+    }
+  }
+  return report;
+}
