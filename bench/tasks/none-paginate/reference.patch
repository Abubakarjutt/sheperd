@@ -0,0 +1,33 @@
+export type PageOptions = { page: number; perPage: number };
+
+export type Page<T> = {
+  items: T[];
+  page: number;
+  perPage: number;
+  totalItems: number;
+  totalPages: number;
+  hasPrev: boolean;
+  hasNext: boolean;
+};
+
+export function paginate<T>(items: readonly T[], opts: PageOptions): Page<T> {
+  const { page, perPage } = opts;
+  if (!Number.isInteger(page) || page < 1) {
+    throw new RangeError(`page must be an integer >= 1, got ${page}`);
+  }
+  if (!Number.isInteger(perPage) || perPage < 1 || perPage > 100) {
+    throw new RangeError(`perPage must be an integer from 1 to 100, got ${perPage}`);
+  }
+  const totalItems = items.length;
+  const totalPages = Math.ceil(totalItems / perPage);
+  const start = (page - 1) * perPage;
+  return {
+    items: items.slice(start, start + perPage),
+    page,
+    perPage,
+    totalItems,
+    totalPages,
+    hasPrev: page > 1,
+    hasNext: page < totalPages,
+  };
+}
