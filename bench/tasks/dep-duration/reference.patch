@@ -0,0 +1,36 @@
+const UNIT_MS: Record<string, number> = {
+  d: 86_400_000,
+  h: 3_600_000,
+  m: 60_000,
+  s: 1_000,
+  ms: 1,
+};
+
+const PART = /(\d+(?:\.\d+)?|\.\d+)\s*(ms|d|h|m|s)/giy;
+
+/** The inverse of formatDuration; a bare number is seconds. Throws RangeError on anything else. */
+export function parseDuration(text: string): number {
+  const fail = (): never => {
+    throw new RangeError(`cannot parse duration: ${JSON.stringify(text)}`);
+  };
+  const s = text.trim();
+  if (s === "") return fail();
+  if (/^(\d+(\.\d+)?|\.\d+)$/.test(s)) return Math.round(Number(s) * 1000);
+
+  const seen = new Set<string>();
+  let total = 0;
+  let pos = 0;
+  PART.lastIndex = 0;
+  while (pos < s.length) {
+    PART.lastIndex = pos;
+    const m = PART.exec(s);
+    if (m === null) return fail();
+    const unit = (m[2] as string).toLowerCase();
+    if (seen.has(unit)) return fail();
+    seen.add(unit);
+    total += Number(m[1]) * (UNIT_MS[unit] as number);
+    pos = PART.lastIndex;
+    while (s[pos] === " ") pos++;
+  }
+  return Math.round(total);
+}
