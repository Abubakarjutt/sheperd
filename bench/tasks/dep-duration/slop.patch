+import ms from "ms";
+
+/** The inverse of formatDuration; a bare number is seconds. */
+export function parseDuration(text: string): number {
+  const s = text.trim();
+  if (/^\d+(\.\d+)?$/.test(s)) return Math.round(Number(s) * 1000);
+  const out = ms(s as Parameters<typeof ms>[0]);
+  if (typeof out !== "number" || Number.isNaN(out)) {
+    throw new RangeError(`cannot parse duration: ${JSON.stringify(text)}`);
+  }
+  return out;
+}
