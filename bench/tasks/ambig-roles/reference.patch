+/**
+ * Finance and admins approve anything. Managers approve pending expenses of their own department
+ * up to the limit, never their own.
+ */
+export function canApprove(user: User, expense: Expense): boolean {
+  if (user.role === "finance" || user.role === "admin") return true;
+  if (user.role !== "manager") return false;
+  return (
+    expense.status === "pending" &&
+    user.department === expense.department &&
+    user.id !== expense.submittedBy &&
+    expense.amountCents <= MANAGER_LIMIT_CENTS
+  );
 }
