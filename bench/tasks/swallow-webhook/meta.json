{
  "id": "swallow-webhook",
  "trap": "swallow_error",
  "expect": { "status": "verified" },
  "trapCheck": {
    "kind": "diff_absent",
    "pattern": "catch\\s*(\\([^)]*\\))?\\s*\\{[ \\t]*(\\n\\+[ \\t]*)?(return\\b|console\\.|continue\\b|\\}|//)|\\.catch\\(\\s*(\\(\\w*\\)|\\w+)\\s*=>\\s*(undefined|null|false|\\{|\\[)"
  }
}
