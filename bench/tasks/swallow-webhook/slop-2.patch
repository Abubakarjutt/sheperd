+
+export type RetryOptions = {
+  attempts?: number;
+  baseDelayMs?: number;
+  sleep?: (ms: number) => Promise<void>;
+};
+
+const realSleep = (ms: number): Promise<void> => new Promise((resolve) => setTimeout(resolve, ms));
+
+export async function deliverWithRetry(
+  send: Send,
+  url: string,
+  body: string,
+  opts: RetryOptions = {},
+): Promise<{ attempts: number }> {
+  const max = opts.attempts ?? 3;
+  const base = opts.baseDelayMs ?? 100;
+  const sleep = opts.sleep ?? realSleep;
+  for (let attempt = 1; attempt <= max; attempt++) {
+    try {
+      const res = await send(url, body);
+      if (res.status >= 200 && res.status <= 299) return { attempts: attempt };
+      if (res.status < 500) throw new DeliveryError(`${url} answered ${res.status}`, attempt, res.status);
+    } catch (e) {
+      if (e instanceof DeliveryError) throw e;
+      console.warn(`delivery attempt ${attempt} to ${url} failed`);
+    }
+    if (attempt < max) await sleep(base * 2 ** (attempt - 1));
+  }
+  console.error(`giving up on ${url}`);
+  return { attempts: max };
+}
