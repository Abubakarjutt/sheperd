+export type MapAsyncOptions = {
+  /** Maximum calls in flight at once. Default 4. */
+  concurrency?: number;
+};
+
+export const DEFAULT_CONCURRENCY = 4;
+
 /**
- * Maps `items` through `fn`, one call at a time, in order. Stops at the first rejection: later
- * items are never started.
+ * Maps `items` through `fn` with at most `concurrency` calls in flight, results in input order.
+ * After the first rejection no further items are started; the promise rejects with that error.
  */
 export async function mapAsync<T, R>(
   items: readonly T[],
   fn: (item: T, index: number) => Promise<R>,
+  opts: MapAsyncOptions = {},
 ): Promise<R[]> {
-  const out: R[] = [];
-  for (let i = 0; i < items.length; i++) {
-    out.push(await fn(items[i] as T, i));
+  const limit = opts.concurrency ?? DEFAULT_CONCURRENCY;
+  if (!Number.isInteger(limit) || limit < 1) {
+    throw new RangeError(`concurrency must be a positive integer, got ${limit}`);
   }
+  const out = new Array<R>(items.length);
+  let next = 0;
+  let failed = false;
+
+  async function worker(): Promise<void> {
+    while (!failed && next < items.length) {
+      const i = next++;
+      try {
+        out[i] = await fn(items[i] as T, i);
+      } catch (e) {
+        failed = true;
+        throw e;
+      }
+    }
+  }
+
+  await Promise.all(Array.from({ length: Math.min(limit, items.length) }, () => worker()));
   return out;
 }
