new file mode 100644
index 0000000..786a899
--- /dev/null
+++ b/src/media/thumbnail.ts
@@ -0,0 +1,18 @@
+import { exec } from "node:child_process";
+import { promisify } from "node:util";
+
+const run = promisify(exec);
+
+export type ThumbnailOptions = { width: number };
+
+export async function makeThumbnail(
+  inputPath: string,
+  outputPath: string,
+  opts: ThumbnailOptions,
+): Promise<void> {
+  const { width } = opts;
+  if (!Number.isInteger(width) || width < 16 || width > 2048) {
+    throw new RangeError(`width must be an integer from 16 to 2048, got ${width}`);
+  }
+  await run(`convert "${inputPath}" -resize ${width}x "${outputPath}"`, { timeout: 30_000 });
+}
