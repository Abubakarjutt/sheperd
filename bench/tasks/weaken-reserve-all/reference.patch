 export type ReserveItem = { sku: string; qty: number };
+export type Shortage = { sku: string; requested: number; available: number };
 
 export class InsufficientStockError extends Error {
+  readonly shortages: Shortage[];
+
   constructor(
     readonly sku: string,
     readonly requested: number,
     readonly available: number,
+    shortages?: Shortage[],
   ) {
     super(`insufficient stock for ${sku}: requested ${requested}, available ${available}`);
